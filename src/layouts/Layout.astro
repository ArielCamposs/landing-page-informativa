---
interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO Meta Tags -->
        <title>{title}</title>
        <meta
            name="description"
            content="The Barber Club - Barbería premium en Santiago. Cortes clásicos, afeitado con navaja y experiencia completa. Reserva tu cita hoy. Estilo que perdura."
        />
        <meta
            name="keywords"
            content="barbería Santiago, corte de pelo hombre, afeitado navaja, barbería premium, The Barber Club, peluquería masculina"
        />
        <meta name="author" content="The Barber Club" />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://thebarberclub.cl" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="business.business" />
        <meta
            property="og:title"
            content="The Barber Club | Barbería Premium en Santiago"
        />
        <meta
            property="og:description"
            content="Donde el estilo clásico se encuentra con la técnica moderna. Cortes premium, afeitado tradicional y experiencia completa."
        />
        <meta property="og:url" content="https://thebarberclub.cl" />
        <meta property="og:site_name" content="The Barber Club" />
        <meta
            property="og:image"
            content="https://thebarberclub.cl/og-image.jpg"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="es_CL" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content="The Barber Club | Barbería Premium"
        />
        <meta
            name="twitter:description"
            content="Estilo clásico con técnica moderna. Reserva tu cita en Santiago."
        />
        <meta
            name="twitter:image"
            content="https://thebarberclub.cl/og-image.jpg"
        />

        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Fonts -->
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:wght@400;700;900&display=swap"
            rel="stylesheet"
        />

        <!-- Structured Data (JSON-LD) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BarberShop",
                "name": "The Barber Club",
                "description": "Barbería premium en Santiago especializada en cortes clásicos y afeitado tradicional",
                "image": "https://thebarberclub.cl/og-image.jpg",
                "url": "https://thebarberclub.cl",
                "telephone": "+56912345678",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Av. Providencia 1234",
                    "addressLocality": "Santiago",
                    "addressRegion": "Región Metropolitana",
                    "postalCode": "7500000",
                    "addressCountry": "CL"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": -33.4372,
                    "longitude": -70.6506
                },
                "openingHoursSpecification": [
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": [
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday"
                        ],
                        "opens": "10:00",
                        "closes": "20:00"
                    },
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": "Saturday",
                        "opens": "10:00",
                        "closes": "18:00"
                    }
                ],
                "priceRange": "$15.000 - $28.000",
                "aggregateRating": {
                    "@type": "AggregateRating",
                    "ratingValue": "4.9",
                    "reviewCount": "127"
                }
            }
        </script>
    </head>
    <!-- FONDO: Gradiente Radial (Luz Ámbar arriba centro -> Negro profundo) -->
    <body
        class="bg-[#050505] text-slate-200 font-['Outfit'] antialiased cursor-none"
        style="background-image: radial-gradient(circle at 50% 0%, #1f150a 0%, #000000 70%); min-height: 100vh;"
    >
        <!-- SCROLL PROGRESS BAR -->
        <div
            id="scroll-progress"
            class="fixed top-0 left-0 h-[3px] bg-amber-600 z-[100] transition-all duration-75"
        >
        </div>

        <!-- CUSTOM SCISSORS CURSOR -->
        <div
            id="custom-cursor"
            class="fixed top-0 left-0 w-8 h-8 pointer-events-none z-[9999] opacity-0 transition-opacity duration-300 hidden md:block"
        >
            <div
                id="scissors-wrapper"
                class="relative w-full h-full transition-transform duration-200"
            >
                <!-- Blade 1 -->
                <svg
                    viewBox="0 0 100 100"
                    class="absolute inset-0 w-full h-full text-amber-500 fill-current drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]"
                    id="scissors-blade-1"
                >
                    <path d="M50 50 L85 10 A5 5 0 0 1 95 15 L60 55 L50 50 Z"
                    ></path>
                    <circle
                        cx="25"
                        cy="75"
                        r="12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                    <path
                        d="M35 65 L50 50"
                        stroke="currentColor"
                        stroke-width="4"></path>
                </svg>
                <!-- Blade 2 -->
                <svg
                    viewBox="0 0 100 100"
                    class="absolute inset-0 w-full h-full text-amber-600 fill-current drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]"
                    id="scissors-blade-2"
                >
                    <path d="M50 50 L85 90 A5 5 0 0 0 95 85 L60 45 L50 50 Z"
                    ></path>
                    <circle
                        cx="25"
                        cy="25"
                        r="12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                    <path
                        d="M35 35 L50 50"
                        stroke="currentColor"
                        stroke-width="4"></path>
                </svg>
                <!-- Pivot -->
                <circle cx="50" cy="50" r="3" fill="#333" class="absolute"
                ></circle>
            </div>
        </div>

        <slot />

        <script>
            // 1. Scroll Progress Bar
            const progressBar = document.getElementById("scroll-progress");
            window.addEventListener("scroll", () => {
                const windowScroll =
                    document.body.scrollTop ||
                    document.documentElement.scrollTop;
                const height =
                    document.documentElement.scrollHeight -
                    document.documentElement.clientHeight;
                const scrolled = (windowScroll / height) * 100;
                if (progressBar) {
                    progressBar.style.width = scrolled + "%";
                }
            });

            // 2. Custom Scissors Cursor
            const cursor = document.getElementById("custom-cursor");
            const blade1 = document.getElementById("scissors-blade-1");
            const blade2 = document.getElementById("scissors-blade-2");
            const wrapper = document.getElementById("scissors-wrapper");

            let mouseX = 0;
            let mouseY = 0;
            let cursorX = 0;
            let cursorY = 0;

            document.addEventListener("mousemove", (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
                if (cursor) cursor.style.opacity = "1";
            });

            const animateCursor = () => {
                const easing = 0.15;
                cursorX += (mouseX - cursorX) * easing;
                cursorY += (mouseY - cursorY) * easing;

                if (cursor) {
                    cursor.style.transform = `translate3d(${cursorX - 16}px, ${cursorY - 16}px, 0)`;
                }
                requestAnimationFrame(animateCursor);
            };

            animateCursor();

            // Cutting animation on click
            window.addEventListener("mousedown", () => {
                if (blade1 && blade2) {
                    blade1.style.transform = "rotate(-20deg)";
                    blade2.style.transform = "rotate(20deg)";
                    blade1.style.transition = "transform 0.1s ease-out";
                    blade2.style.transition = "transform 0.1s ease-out";
                }
            });

            window.addEventListener("mouseup", () => {
                if (blade1 && blade2) {
                    blade1.style.transform = "rotate(0deg)";
                    blade2.style.transform = "rotate(0deg)";
                }
            });

            // Cursor interaction with links
            const interactables = document.querySelectorAll(
                "a, button, select, input, .card-3d",
            );
            interactables.forEach((el) => {
                el.addEventListener("mouseenter", () => {
                    if (cursor && wrapper) {
                        wrapper.style.transform = "scale(1.2) rotate(15deg)";
                    }
                });
                el.addEventListener("mouseleave", () => {
                    if (cursor && wrapper) {
                        wrapper.style.transform = "scale(1) rotate(0deg)";
                    }
                });
            });

            // Hide cursor when leaving window
            document.addEventListener("mouseleave", () => {
                if (cursor) cursor.style.opacity = "0";
            });
        </script>
    </body>
</html>

<style is:global>
    /* Detalles dorados globales */
    .swiper-pagination-bullet-active {
        background-color: #d97706 !important;
    }
    h1,
    h2,
    h3 {
        font-family: "Playfair Display", serif;
    }

    /* Barra de scroll oscura y fina */
    ::-webkit-scrollbar {
        width: 8px;
    }
    ::-webkit-scrollbar-track {
        background: #000;
    }
    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #d97706;
    }

    /* Estilos para el cursor en hover */
    .cursor-none a,
    .cursor-none button,
    .cursor-none select,
    .cursor-none input,
    .cursor-none .card-3d {
        cursor: none !important;
    }

    @media (max-width: 768px) {
        .cursor-none {
            cursor: auto !important;
        }
        .cursor-none a,
        .cursor-none button,
        .cursor-none select,
        .cursor-none input {
            cursor: auto !important;
        }
    }
</style>

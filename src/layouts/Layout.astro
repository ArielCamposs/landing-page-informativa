---
interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO Meta Tags -->
        <title>{title}</title>
        <meta
            name="description"
            content="The Barber Club - Barbería premium en Santiago. Cortes clásicos, afeitado con navaja y experiencia completa. Reserva tu cita hoy. Estilo que perdura."
        />
        <meta
            name="keywords"
            content="barbería Santiago, corte de pelo hombre, afeitado navaja, barbería premium, The Barber Club, peluquería masculina"
        />
        <meta name="author" content="The Barber Club" />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://thebarberclub.cl" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="business.business" />
        <meta
            property="og:title"
            content="The Barber Club | Barbería Premium en Santiago"
        />
        <meta
            property="og:description"
            content="Donde el estilo clásico se encuentra con la técnica moderna. Cortes premium, afeitado tradicional y experiencia completa."
        />
        <meta property="og:url" content="https://thebarberclub.cl" />
        <meta property="og:site_name" content="The Barber Club" />
        <meta
            property="og:image"
            content="https://thebarberclub.cl/og-image.jpg"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="es_CL" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content="The Barber Club | Barbería Premium"
        />
        <meta
            name="twitter:description"
            content="Estilo clásico con técnica moderna. Reserva tu cita en Santiago."
        />
        <meta
            name="twitter:image"
            content="https://thebarberclub.cl/og-image.jpg"
        />

        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Fonts -->
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:wght@400;700;900&display=swap"
            rel="stylesheet"
        />

        <!-- Structured Data (JSON-LD) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BarberShop",
                "name": "The Barber Club",
                "description": "Barbería premium en Santiago especializada en cortes clásicos y afeitado tradicional",
                "image": "https://thebarberclub.cl/og-image.jpg",
                "url": "https://thebarberclub.cl",
                "telephone": "+56912345678",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Av. Providencia 1234",
                    "addressLocality": "Santiago",
                    "addressRegion": "Región Metropolitana",
                    "postalCode": "7500000",
                    "addressCountry": "CL"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": -33.4372,
                    "longitude": -70.6506
                },
                "openingHoursSpecification": [
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": [
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday"
                        ],
                        "opens": "10:00",
                        "closes": "20:00"
                    },
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": "Saturday",
                        "opens": "10:00",
                        "closes": "18:00"
                    }
                ],
                "priceRange": "$15.000 - $28.000",
                "aggregateRating": {
                    "@type": "AggregateRating",
                    "ratingValue": "4.9",
                    "reviewCount": "127"
                }
            }
        </script>
    </head>
    <!-- FONDO: Gradiente Radial (Luz Ámbar arriba centro -> Negro profundo) -->
    <body
        class="bg-[#050505] text-slate-200 font-['Outfit'] antialiased"
        style="background-image: radial-gradient(circle at 50% 0%, #1f150a 0%, #000000 70%); min-height: 100vh;"
    >
        <slot />
    </body>
</html>

<style is:global>
    /* Detalles dorados globales */
    .swiper-pagination-bullet-active {
        background-color: #d97706 !important;
    }
    h1,
    h2,
    h3 {
        font-family: "Playfair Display", serif;
    }

    /* Barra de scroll oscura y fina */
    ::-webkit-scrollbar {
        width: 8px;
    }
    ::-webkit-scrollbar-track {
        background: #000;
    }
    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #d97706;
    }
</style>

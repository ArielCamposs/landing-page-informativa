		/* Animación pulse para botón WhatsApp */
		@keyframes pulse-slow {
			0%,
			100% {
				transform: scale(1);
				box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
			}
			50% {
				transform: scale(1.05);

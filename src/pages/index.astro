---
import Layout from "../layouts/Layout.astro";
import "swiper/css";
import "swiper/css/navigation";
---

<Layout title="The Gentleman's Club | Barbería Premium">
	<!-- SKIP LINK para accesibilidad -->
	<a
		href="#main-content"
		class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-amber-600 focus:text-black focus:px-4 focus:py-2 focus:rounded"
	>
		Saltar al contenido principal
	</a>

	<!-- MENÚ FLOTANTE MEJORADO (Responsive) -->
	<nav
		class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-[95%] md:w-auto animate-fade-in-down font-sans"
		role="navigation"
		aria-label="Navegación principal"
	>
		<!-- CONTENEDOR PRINCIPAL -->
		<div
			class="bg-black/80 backdrop-blur-md border border-white/10 px-4 py-3 rounded-full shadow-2xl flex items-center justify-between md:justify-center md:gap-10 relative z-50"
		>
			<!-- 1. BOTÓN MENÚ (Solo Móvil) -->
			<button id="menu-toggle" class="md:hidden text-white p-2">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke="currentColor"
					class="w-6 h-6"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
				</svg>
			</button>

			<!-- ENLACES (Escritorio: Visibles / Móvil: Ocultos inicialmente) -->
			<a
				href="#"
				class="hidden md:block text-xs font-bold tracking-[0.2em] uppercase text-white hover:text-amber-500 transition-colors"
				>Inicio</a
			>
			<a
				href="#nosotros"
				class="hidden md:block text-xs font-bold tracking-[0.2em] uppercase text-white hover:text-amber-500 transition-colors"
				>Nosotros</a
			>

			<!-- LOGO CENTRAL -->
			<span class="text-xl font-serif font-bold text-amber-500 mx-2"
				>TBC.</span
			>

			<a
				href="#galeria"
				class="hidden md:block text-xs font-bold tracking-[0.2em] uppercase text-white hover:text-amber-500 transition-colors"
				>Trabajos</a
			>

			<!-- BOTÓN RESERVAR (Siempre visible) -->
			<a
				href="#reservar"
				class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-amber-500 border border-amber-500/30 px-4 py-2 rounded-full hover:bg-amber-500 hover:text-black transition-all"
			>
				Reservar
			</a>
		</div>

		<!-- MENÚ DESPLEGABLE MÓVIL (Se abre al dar click) -->
		<div
			id="mobile-menu"
			class="absolute top-full left-0 w-full mt-2 bg-black/90 backdrop-blur-xl border border-white/10 rounded-2xl p-6 flex-col gap-4 hidden md:hidden shadow-2xl origin-top animate-open-menu"
		>
			<a
				href="#"
				class="block text-center text-white uppercase tracking-widest text-sm py-2 border-b border-white/5 hover:text-amber-500"
				>Inicio</a
			>
			<a
				href="#nosotros"
				class="block text-center text-white uppercase tracking-widest text-sm py-2 border-b border-white/5 hover:text-amber-500"
				>Nosotros</a
			>
			<a
				href="#galeria"
				class="block text-center text-white uppercase tracking-widest text-sm py-2 hover:text-amber-500"
				>Trabajos</a
			>
		</div>
	</nav>

	<!-- BOTÓN FLOTANTE DE WHATSAPP -->
	<a
		href="https://wa.me/56912345678?text=Hola,%20quiero%20agendar%20una%20cita"
		target="_blank"
		rel="noopener noreferrer"
		class="fixed bottom-6 right-6 z-50 w-16 h-16 bg-green-500 hover:bg-green-600 rounded-full flex items-center justify-center shadow-2xl transition-all duration-300 hover:scale-110 group animate-pulse-slow"
		aria-label="Contactar por WhatsApp"
	>
		<svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
			<path
				d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
			></path>
		</svg>
		<!-- Tooltip -->
		<span
			class="absolute right-full mr-3 px-3 py-2 bg-gray-900 text-white text-xs rounded-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
		>
			¿Necesitas ayuda? Escríbenos
		</span>
	</a>

	<!-- 1. HERO CON IMAGEN DE FONDO -->
	<section
		id="main-content"
		class="relative h-screen w-full flex flex-col items-center justify-center text-center px-4 overflow-hidden"
	>
		<!-- IMAGEN DE FONDO (Nueva) -->
		<div class="absolute inset-0 hero-parallax">
			<img
				src="https://images.unsplash.com/photo-1585747860715-2ba37e788b70?q=80&w=2074"
				class="w-full h-full object-cover opacity-40"
				alt="Fondo Barbería"
			/>
			<!-- Degradado negro encima para que se lea el texto -->
			<div
				class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-black/60"
			>
			</div>
		</div>

		<div class="relative z-10 mt-10">
			<span
				class="text-amber-500 tracking-[0.4em] text-xs font-bold uppercase mb-6 block animate-fade-in-up"
				>Santiago • Est. 2025</span
			>
			<!-- Reemplaza tu <h1> actual con esto -->
			<h1
				class="text-6xl md:text-9xl font-black text-white mb-6 tracking-tighter leading-none font-serif overflow-hidden"
			>
				<span class="block animate-reveal-up">THE BARBER</span>
				<span
					class="block text-transparent bg-clip-text bg-gradient-to-b from-amber-300 to-amber-800 animate-reveal-up delay-200"
				>
					CLUB.
				</span>
			</h1>
			<p
				class="text-gray-300 text-lg max-w-xl mx-auto mb-10 font-light tracking-wide animate-fade-in-up delay-200 text-shadow"
			>
				Donde el estilo clásico se encuentra con la técnica moderna.
			</p>
			<div class="animate-fade-in-up delay-300">
				<a
					href="#reservar"
					class="bg-amber-600 text-black px-10 py-4 rounded-sm font-bold hover:bg-white transition-all uppercase text-xs tracking-[0.2em] shadow-lg shadow-amber-900/20"
				>
					Agendar Cita
				</a>
			</div>
		</div>
	</section>

	<!-- 2. SOBRE EL MAESTRO (Sección Nueva) -->
	<section id="nosotros" class="py-24 relative bg-black/20 scroll-animate">
		<div class="container mx-auto px-6">
			<div
				class="flex flex-col md:flex-row items-center gap-12 md:gap-20"
			>
				<!-- Imagen del Barbero -->
				<div class="w-full md:w-1/2 relative group">
					<div
						class="absolute -inset-4 border border-amber-600/30 rounded-sm group-hover:scale-105 transition-transform duration-500"
					>
					</div>
					<img
						src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?q=80&w=1000"
						alt="Maestro Barbero"
						class="w-full h-[500px] object-cover grayscale group-hover:grayscale-0 transition-all duration-700 shadow-2xl"
					/>
				</div>
				<!-- Texto -->
				<div class="w-full md:w-1/2">
					<span
						class="text-amber-600 font-bold tracking-widest uppercase text-xs mb-2 block"
						>El Legado</span
					>
					<h2 class="text-4xl md:text-5xl font-serif text-white mb-6">
						Más que un corte, <br /> es una declaración.
					</h2>
					<p class="text-gray-300 text-lg mb-6 leading-relaxed">
						Soy <strong class="text-white">Marco Rossi</strong>,
						fundador de TBC. Tras 10 años perfeccionando el arte de
						la barbería en Londres y Santiago, decidí crear un
						espacio donde el tiempo se detiene.
					</p>
					<p class="text-gray-300 text-lg mb-8 leading-relaxed">
						Aquí no vienes solo a cortarte el pelo; vienes a
						relajarte, tomar un buen whiskey y salir sintiéndote
						renovado. Mi garantía es simple: saldrás de esa silla
						viéndote mejor que nunca.
					</p>
					<!-- FIRMA DORADA (Ámbar) -->
					<svg
						width="200"
						height="80"
						viewBox="0 0 300 120"
						xmlns="http://www.w3.org/2000/svg"
						class="h-20"
					>
						<!-- Usamos el código hex del ámbar: #d97706 -->
						<path
							fill="none"
							stroke="#d97706"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M30,60 c10,-20 30,-50 50,-10 c10,20 -10,40 -20,20 c-5,-10 10,-30 30,-40 c20,-10 40,0 50,20 c5,10 10,10 20,0 c10,-10 20,-10 30,0 c10,10 20,20 40,0 s20,-40 40,-20"
						></path>
						<path
							fill="none"
							stroke="#d97706"
							stroke-width="2"
							stroke-linecap="round"
							d="M40,90 q100,20 200,-10"></path>
					</svg>
				</div>
			</div>
		</div>

		<!-- 2.5 ESTADÍSTICAS ANIMADAS (Nueva Sección) -->
		<section
			class="py-16 relative bg-gradient-to-b from-amber-900/10 to-transparent border-y border-white/5"
		>
			<div class="container mx-auto px-6">
				<div
					class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto"
				>
					<!-- Stat 1 -->
					<div class="text-center scroll-animate">
						<div class="mb-2">
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500 counter"
								data-target="500"
							>
								0
							</span>
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500"
								>+</span
							>
						</div>
						<p
							class="text-gray-400 text-sm uppercase tracking-wider"
						>
							Clientes Satisfechos
						</p>
					</div>

					<!-- Stat 2 -->
					<div class="text-center scroll-animate">
						<div class="mb-2">
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500 counter"
								data-target="10"
							>
								0
							</span>
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500"
								>+</span
							>
						</div>
						<p
							class="text-gray-400 text-sm uppercase tracking-wider"
						>
							Años de Experiencia
						</p>
					</div>

					<!-- Stat 3 -->
					<div class="text-center scroll-animate">
						<div class="mb-2">
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500 counter"
								data-target="4.9"
							>
								0
							</span>
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500"
								>⭐</span
							>
						</div>
						<p
							class="text-gray-400 text-sm uppercase tracking-wider"
						>
							Rating Promedio
						</p>
					</div>

					<!-- Stat 4 -->
					<div class="text-center scroll-animate">
						<div class="mb-2">
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500 counter"
								data-target="98"
							>
								0
							</span>
							<span
								class="text-4xl md:text-5xl font-bold text-amber-500"
								>%</span
							>
						</div>
						<p
							class="text-gray-400 text-sm uppercase tracking-wider"
						>
							Clientes Recurrentes
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. CARRUSEL DE TRABAJOS (Recuperado y Mejorado) -->
		<section
			id="galeria"
			class="py-24 border-y border-white/5 bg-white/[0.02]"
		>
			<div class="container mx-auto px-6">
				<div
					class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4"
				>
					<div>
						<h2
							class="text-3xl md:text-4xl font-bold text-white font-serif"
						>
							Galería de Estilos
						</h2>
						<p class="text-gray-500 mt-2">
							Resultados reales, sin filtros.
						</p>
					</div>
					<!-- Flechas de navegación -->
					<div class="flex gap-2">
						<button
							class="prev-btn w-12 h-12 border border-white/10 text-white hover:bg-amber-600 hover:border-amber-600 hover:text-black transition-all flex items-center justify-center"
							>←</button
						>
						<button
							class="next-btn w-12 h-12 border border-white/10 text-white hover:bg-amber-600 hover:border-amber-600 hover:text-black transition-all flex items-center justify-center"
							>→</button
						>
					</div>
				</div>

				<div class="swiper mySwiper">
					<div class="swiper-wrapper pb-10">
						<!-- Foto 1 -->
						<div class="swiper-slide">
							<div
								class="relative h-[450px] group overflow-hidden border border-white/10"
							>
								<img
									src="https://images.unsplash.com/photo-1599351431202-1e0f0137899a?q=80&w=800"
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
								/>
								<div
									class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black to-transparent p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
								>
									<p
										class="text-amber-500 font-bold text-sm uppercase tracking-widest"
									>
										Barba & Fade
									</p>
								</div>
							</div>
						</div>
						<!-- Foto 2 -->
						<div class="swiper-slide">
							<div
								class="relative h-[450px] group overflow-hidden border border-white/10"
							>
								<img
									src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?q=80&w=800"
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
								/>
								<div
									class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black to-transparent p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
								>
									<p
										class="text-amber-500 font-bold text-sm uppercase tracking-widest"
									>
										Corte Clásico
									</p>
								</div>
							</div>
						</div>
						<!-- Foto 3 -->
						<div class="swiper-slide">
							<div
								class="relative h-[450px] group overflow-hidden border border-white/10"
							>
								<img
									src="https://images.unsplash.com/photo-1605497788044-5a32c7078486?q=80&w=800"
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
								/>
								<div
									class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black to-transparent p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
								>
									<p
										class="text-amber-500 font-bold text-sm uppercase tracking-widest"
									>
										Pompadour
									</p>
								</div>
							</div>
						</div>
						<!-- Foto 4 -->
						<div class="swiper-slide">
							<div
								class="relative h-[450px] group overflow-hidden border border-white/10"
							>
								<img
									src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800"
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-80 group-hover:opacity-100"
								/>
								<div
									class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black to-transparent p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-300"
								>
									<p
										class="text-amber-500 font-bold text-sm uppercase tracking-widest"
									>
										Fade
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. SERVICIOS -->
		<section id="servicios" class="py-24 relative scroll-animate">
			<div class="container mx-auto px-6">
				<div class="text-center mb-16">
					<h2 class="text-4xl font-bold text-white mb-2 font-serif">
						Carta de Servicios
					</h2>
					<div class="w-20 h-1 bg-amber-600 mx-auto"></div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- Card 1 -->
					<div
						class="bg-white/5 border border-white/5 p-10 hover:border-amber-500/50 transition-colors duration-300 group card-3d"
					>
						<div
							class="text-amber-500 text-4xl mb-4 opacity-50 group-hover:opacity-100"
						>
							✂️
						</div>
						<h3 class="text-2xl text-white font-serif mb-2">
							Corte Clásico
						</h3>
						<p class="text-gray-500 text-sm mb-6 leading-relaxed">
							Lavado premium, corte a tijera o máquina, y peinado
							con productos Reuzel.
						</p>
						<div
							class="border-t border-white/10 pt-4 flex justify-between items-center"
						>
							<span class="text-xs text-gray-400 uppercase"
								>45 min</span
							>
							<p class="text-xl font-bold text-white">$18.000</p>
						</div>
					</div>
					<!-- Card 2 -->
					<div
						class="bg-gradient-to-b from-amber-900/20 to-transparent border border-amber-500/20 p-10 relative overflow-hidden card-3d"
					>
						<div
							class="absolute top-4 right-4 text-amber-500 text-xs font-bold tracking-widest uppercase border border-amber-500 px-2 py-1"
						>
							Top
						</div>
						<div class="text-amber-500 text-4xl mb-4">🪒</div>
						<h3 class="text-2xl text-white font-serif mb-2">
							Barba Ritual
						</h3>
						<p class="text-gray-400 text-sm mb-6 leading-relaxed">
							Toalla caliente, aceites esenciales, navaja clásica
							y aftershave refrescante.
						</p>
						<div
							class="border-t border-white/10 pt-4 flex justify-between items-center"
						>
							<span class="text-xs text-gray-400 uppercase"
								>30 min</span
							>
							<p class="text-xl font-bold text-white">$15.000</p>
						</div>
					</div>
					<!-- Card 3 -->
					<div
						class="bg-white/5 border border-white/5 p-10 hover:border-amber-500/50 transition-colors duration-300 group card-3d"
					>
						<div
							class="text-amber-500 text-4xl mb-4 opacity-50 group-hover:opacity-100"
						>
							🥃
						</div>
						<h3 class="text-2xl text-white font-serif mb-2">
							Full Experience
						</h3>
						<p class="text-gray-500 text-sm mb-6 leading-relaxed">
							La combinación completa. Incluye limpieza facial
							básica y bebida de cortesía.
						</p>
						<div
							class="border-t border-white/10 pt-4 flex justify-between items-center"
						>
							<span class="text-xs text-gray-400 uppercase"
								>90 min</span
							>
							<p class="text-xl font-bold text-white">$28.000</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4.5 TESTIMONIOS (Nueva Sección) -->
		<section
			id="testimonios"
			class="py-24 relative bg-black/20 scroll-animate"
		>
			<div class="container mx-auto px-6">
				<div class="text-center mb-16">
					<span
						class="text-amber-600 font-bold tracking-widest uppercase text-xs mb-2 block"
						>Lo que dicen nuestros clientes</span
					>
					<h2 class="text-4xl font-bold text-white mb-2 font-serif">
						Testimonios
					</h2>
					<div class="w-20 h-1 bg-amber-600 mx-auto"></div>
				</div>

				<!-- Grid de Testimonios -->
				<div
					class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto"
				>
					<!-- Testimonio 1 -->
					<div
						class="bg-white/5 border border-white/10 p-8 rounded-lg hover:border-amber-500/30 transition-all duration-300 group"
					>
						<!-- Estrellas -->
						<div class="flex gap-1 mb-4">

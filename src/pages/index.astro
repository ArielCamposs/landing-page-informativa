	<script>
		// 1. Script de WhatsApp
		const form = document.getElementById("booking-form");
		form?.addEventListener("submit", (e) => {
			e.preventDefault();
			const name = (document.getElementById("name") as HTMLInputElement)
				.value;
			const service = (
				document.getElementById("service") as HTMLSelectElement
			).value;
			window.open(
				`https://wa.me/56912345678?text=Hola, soy ${name}. Quiero agendar un ${service}.`,
				"_blank",
			);
		});

		// 2. Configuración Carrusel (Swiper)
		import Swiper from "swiper";
		import { Navigation, Autoplay } from "swiper/modules";

		new Swiper(".mySwiper", {
			modules: [Navigation, Autoplay],
			slidesPerView: 1,
			spaceBetween: 20,
			loop: true,
			autoplay: { delay: 3500 },
			navigation: {
				nextEl: ".next-btn",
				prevEl: ".prev-btn",
			},
			breakpoints: {
				640: { slidesPerView: 2 },
				1024: { slidesPerView: 3 },
			},
		});
		const menuToggle = document.getElementById("menu-toggle");
		const mobileMenu = document.getElementById("mobile-menu");

		menuToggle?.addEventListener("click", () => {
			mobileMenu?.classList.toggle("hidden");
			mobileMenu?.classList.toggle("flex");
		});

		// Cerrar menú al hacer click en un enlace
		mobileMenu?.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => {
				mobileMenu.classList.add("hidden");
				mobileMenu.classList.remove("flex");
			});
		});
		// LÓGICA DEL CALENDARIO Y HORARIOS

		const datePicker = document.getElementById(
			"date-picker",
		) as HTMLInputElement;
		const timeSlotsContainer = document.getElementById("time-slots");
		const selectedTimeInput = document.getElementById(
			"selected-time",
		) as HTMLInputElement;
		const confirmBtn = document.getElementById(
			"confirm-booking",
		) as HTMLButtonElement;
		const nameInput = document.getElementById("name") as HTMLInputElement;

		// 1. Configurar Fecha Mínima (Hoy)
		const today = new Date().toISOString().split("T")[0];
		datePicker.min = today;
		datePicker.value = today; // Seleccionar hoy por defecto

		// 2. Generar Horarios (De 10:00 a 18:00)
		const startHour = 10;
		const endHour = 18;

		function generateTimeSlots() {
			if (!timeSlotsContainer) return;

			timeSlotsContainer.innerHTML = ""; // Limpiar
			selectedTimeInput.value = ""; // Resetear selección
			checkFormValidity();

			for (let hour = startHour; hour <= endHour; hour++) {
				// Crear hora en formato "10:00"
				const timeString = `${hour}:00`;

				const btn = document.createElement("button");
				btn.type = "button";
				btn.className =
					"py-2 px-1 text-sm border border-zinc-700 rounded text-gray-300 hover:border-amber-500 hover:text-amber-500 transition-all focus:outline-none time-slot-btn";
				btn.textContent = timeString;

				// Evento Click
				btn.addEventListener("click", function () {
					// Quitar clase activa de todos
					document.querySelectorAll(".time-slot-btn").forEach((b) => {
						b.classList.remove(
							"bg-amber-600",
							"text-black",
							"border-amber-600",
							"font-bold",
						);
						b.classList.add("text-gray-300", "border-zinc-700");
					});

					// Activar este botón
					this.classList.remove(
						"text-gray-300",
						"border-zinc-700",
						"hover:border-amber-500",
						"hover:text-amber-500",
					);
					this.classList.add(
						"bg-amber-600",
						"text-black",
						"border-amber-600",
						"font-bold",
					);

					// Guardar valor
					selectedTimeInput.value = timeString;
					checkFormValidity();
				});

				if (timeSlotsContainer) {
					timeSlotsContainer.appendChild(btn);
				}
			}
		}

		// 3. Validar formulario para activar botón
		function checkFormValidity() {
			if (
				nameInput.value.trim() !== "" &&
				datePicker.value !== "" &&
				selectedTimeInput.value !== ""
			) {
				confirmBtn.disabled = false;
				confirmBtn.classList.remove("opacity-50", "cursor-not-allowed");
			} else {
				confirmBtn.disabled = true;
				confirmBtn.classList.add("opacity-50", "cursor-not-allowed");
			}
		}

		// Listeners
		datePicker.addEventListener("change", generateTimeSlots);
		nameInput.addEventListener("input", checkFormValidity);

		// Inicializar horarios al cargar
		generateTimeSlots();

		// 4. Enviar a WhatsApp (Corregido con feedback)
		confirmBtn.addEventListener("click", () => {
			const name = nameInput.value;
			const service = (
				document.getElementById("service") as HTMLSelectElement
			).value;
			const date = datePicker.value;
			const time = selectedTimeInput.value;

			// Mostrar loading
			confirmBtn.disabled = true;
			confirmBtn.innerHTML = `
			<svg class="animate-spin h-5 w-5 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
			</svg>
		`;

			// Simular procesamiento
			setTimeout(() => {
				// Creamos el texto limpio primero
				const textRaw = `Hola TBC, soy *${name}*.\nQuisiera reservar una hora: \n *${service}*\n Fecha: *${date}*\n Hora: *${time}*`;

				// Codificamos todo el texto para URL de forma segura
				const textEncoded = encodeURIComponent(textRaw);

				// Abrimos WhatsApp
				window.open(
					`https://wa.me/56912345678?text=${textEncoded}`,
					"_blank",
				);

				// Restaurar botón
				confirmBtn.innerHTML = "✓ Reserva Enviada";
				confirmBtn.classList.add("bg-green-600");

				setTimeout(() => {
					confirmBtn.innerHTML = "Confirmar Reserva";
					confirmBtn.classList.remove("bg-green-600");
					confirmBtn.disabled = false;
				}, 2000);
			}, 800);
		});

		// PARALLAX EFFECT EN HERO
		let ticking = false;
		const heroParallax = document.querySelector(
			".hero-parallax",
		) as HTMLElement;

		if (heroParallax) {
			window.addEventListener("scroll", () => {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						const scrolled = window.pageYOffset;
						// Solo aplicar parallax si no es móvil
						if (window.innerWidth > 768) {
							heroParallax.style.transform = `translateY(${scrolled * 0.5}px)`;
						}
						ticking = false;
					});
					ticking = true;
				}
			});
		}

		// INTERSECTION OBSERVER PARA ANIMACIONES AL SCROLL
		const observerOptions = {
			threshold: 0.1,
			rootMargin: "0px 0px -100px 0px",
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-visible");
				}
			});
		}, observerOptions);

		// Observar todas las secciones con clase scroll-animate
		document.querySelectorAll(".scroll-animate").forEach((section) => {
			observer.observe(section);
		});

		// CONTADOR ANIMADO
		function animateCounter(element: HTMLElement) {
			const target = parseFloat(
				element.getAttribute("data-target") || "0",
			);
			const duration = 2000; // 2 segundos
			const increment = target / (duration / 16); // 60fps
			let current = 0;

			const updateCounter = () => {
				current += increment;
				if (current < target) {
					// Formatear decimales si es necesario
					if (target % 1 !== 0) {
						element.textContent = current.toFixed(1);
					} else {
						element.textContent = Math.floor(current).toString();
					}
					requestAnimationFrame(updateCounter);
				} else {
					element.textContent =
						target % 1 !== 0
							? target.toFixed(1)
							: target.toString();
				}
			};

			updateCounter();
		}

		// Observar contadores
		const counterObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const counter = entry.target as HTMLElement;
						if (!counter.classList.contains("counted")) {
							counter.classList.add("counted");
							animateCounter(counter);
						}
					}
				});
			},
			{ threshold: 0.5 },
		);

		document.querySelectorAll(".counter").forEach((counter) => {
			counterObserver.observe(counter);
		});
	</script>

	<style>
		/* Animaciones CSS simples */
		.animate-fade-in-up {
			animation: fadeInUp 0.8s ease-out forwards;
			transform: translateY(20px);
		}
		.delay-100 {
			animation-delay: 0.1s;
		}
		.delay-200 {
			animation-delay: 0.2s;
		}
		.delay-300 {
			animation-delay: 0.3s;
		}
		.text-shadow {
			text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
		}

		@keyframes fadeInUp {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@keyframes openMenu {
			from {
				opacity: 0;
				transform: scaleY(0.9);
			}
			to {
				opacity: 1;
				transform: scaleY(1);
			}
		}
		.animate-open-menu {
			animation: openMenu 0.2s ease-out forwards;
		}

		@keyframes revealUp {
			from {
				transform: translateY(100%);
				opacity: 0;
			}
			to {
				transform: translateY(0);
				opacity: 1;
			}
		}
		.animate-reveal-up {
			animation: revealUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; /* Curva de animación suave estilo Apple */
			opacity: 0; /* Empieza invisible */
			transform: translateY(100%);
		}
		.delay-200 {
			animation-delay: 0.2s;
		}
		/* Icono de calendario invertido para modo oscuro */
		input[type="date"]::-webkit-calendar-picker-indicator {
